          "discarded": 218,
          "columns_before": 11,
          "columns_after": 12,
          "rules": [
            {
              "rule": "Descartar ordenes sin fecha de pedido o de entrega",
              "reason": "Sin ambas fechas no se puede medir el plazo",
              "rows": 87,
              "kind": "descarte"
            },
            {
              "rule": "Conservar solo ordenes en estado ['Delivered', 'Partially Delivered']",
              "reason": "Una orden cancelada o pendiente no evidencia un plazo real",
              "rows": 130,
              "kind": "descarte"
            },
            {
              "rule": "Descartar plazos fuera de (0, 365] dias",
              "reason": "Entrega anterior al pedido o plazo implausible",
              "rows": 1,
              "kind": "descarte"
            },
            {
              "rule": "Imputar Defective_Units nulo como cero",
              "reason": "Ausencia de registro significa que no se reportaron defectos",
              "rows": 136,
              "kind": "ajuste"
            },
            {
              "rule": "RESULTADO",
              "reason": "De 777 filas quedan 559",
              "rows": 218,
              "kind": "resultado"
            }
          ]
        }
