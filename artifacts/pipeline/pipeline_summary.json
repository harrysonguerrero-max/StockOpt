          "rows_after": 218800,
          "discarded": 200,
          "columns_before": 22,
          "columns_after": 23,
          "rules": [
            {
              "rule": "Rellenar wo_type nulo con SIN_ORDEN",
              "reason": "El nulo significa movimiento sin orden de trabajo asociada",
              "rows": 176207,
              "kind": "ajuste"
            },
            {
              "rule": "Descartar meses con menos de 20 dias registrados",
              "reason": "Meses incompletos se leerian como caida de demanda: ['2025-01']",
              "rows": 200,
              "kind": "descarte"
            },
            {
              "rule": "RESULTADO",
              "reason": "De 219000 filas quedan 218800",
              "rows": 200,
              "kind": "resultado"
            },
            {
              "rule": "Marcar lecturas de sensor atipicas",
              "reason": "Se conservan porque una lectura extrema anticipa la falla",
              "rows": 44860,
              "kind": "ajuste"
            }
          ]
        },
        {
          "key": "procurement",
          "name": "Procurement KPI Analysis Dataset.csv",
          "rows_before": 777,
