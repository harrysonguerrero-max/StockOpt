        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TB\n    subgraph \&quot;1. Data Ingestion\&quot;\n        SKU[\&quot;Maestro de Piezas&lt;br/&gt;(SKU, Categoría,&lt;br/&gt;Criticidad, Vida Útil)\&quot;]\n        INV[\&quot;Inventario Actual&lt;br/&gt;(Stock por Ciudad/Bodega)\&quot;]\n        DEMAND[\&quot;Demanda Histórica&lt;br/&gt;(Señal Operativa)\&quot;]\n        PROVIDERS[\&quot;Proveedores&lt;br/&gt;(Precio, Ciudad,&lt;br/&gt;Lead Time, MOQ,&lt;br/&gt;Capacidad, Flete)\&quot;]\n    end\n\n    subgraph \&quot;2. Data Processing\&quot;\n        CONSOLIDATE[\&quot;Consolidación de Datos\&quot;]\n        VALIDATION[\&quot;Validación de Datos\&quot;]\n    end\n\n    subgraph \&quot;3. Forecast Module\&quot;\n        PATTERN[\&quot;Clasificación de Patrones&lt;br/&gt;(Trend, Seasonal, Random)\&quot;]\n        FORECAST[\&quot;Proyección de Demanda&lt;br/&gt;(ML/Statistical Models)\&quot;]\n        CONFIDENCE[\&quot;Score de Confianza\&quot;]\n    end\n\n    subgraph \&quot;4. Optimization Module\&quot;\n        MIN_INV[\&quot;Cálculo Inventario Mínimo\&quot;]\n        MAX_INV[\&quot;Cálculo Inventario Máximo\&quot;]\n        ORDER_QTY[\&quot;Cantidad de Compra Sugerida\&quot;]\n        LIFE_VALIDATION[\&quot;Validación Vida Útil\&quot;]\n        PROVIDER_SELECT[\&quot;Selección de Proveedor&lt;br/&gt;(Costo + Restricciones)\&quot;]\n    end\n\n    subgraph \&quot;5. Recommendation Engine\&quot;\n        RULES[\&quot;Motor de Reglas de Negocio\&quot;]\n        RECOMMEND[\&quot;Generación de Recomendación\&quot;]\n        NATURAL_LANG[\&quot;Explicación en Lenguaje Natural\&quot;]\n    end\n\n    subgraph \&quot;6. Human Validation\&quot;\n        APPROVAL[\&quot;Dashboard de Validación\&quot;]\n        FEEDBACK[\&quot;Captura de Feedback\&quot;]\n        EXECUTION[\&quot;Ejecución de Compra\&quot;]\n    end\n\n    subgraph \&quot;7. Monitoring &amp; Feedback\&quot;\n        METRICS[\&quot;Cálculo de Métricas&lt;br/&gt;(Cumplimiento, Quiebres,&lt;br/&gt;Sobrestock, Confianza)\&quot;]\n        RETRAINING[\&quot;Reentrenamiento del Modelo&lt;br/&gt;(Datos Observados)\&quot;]\n        RULES_ITERATION[\&quot;Iteración de Reglas&lt;br/&gt;de Negocio\&quot;]\n    end\n\n    SKU --&gt; CONSOLIDATE\n    INV --&gt; CONSOLIDATE\n    DEMAND --&gt; CONSOLIDATE\n    PROVIDERS --&gt; CONSOLIDATE\n    \n    CONSOLIDATE --&gt; VALIDATION\n    VALIDATION --&gt; PATTERN\n    \n    PATTERN --&gt; FORECAST\n    FORECAST --&gt; CONFIDENCE\n    CONFIDENCE --&gt; MIN_INV\n    \n    MIN_INV --&gt; MAX_INV\n    MAX_INV --&gt; ORDER_QTY\n    ORDER_QTY --&gt; LIFE_VALIDATION\n    LIFE_VALIDATION --&gt; PROVIDER_SELECT\n    \n    PROVIDER_SELECT --&gt; RULES\n    RULES --&gt; RECOMMEND\n    RECOMMEND --&gt; NATURAL_LANG\n    \n    NATURAL_LANG --&gt; APPROVAL\n    APPROVAL --&gt; FEEDBACK\n    FEEDBACK --&gt; EXECUTION\n    \n    EXECUTION --&gt; METRICS\n    METRICS --&gt; RETRAINING\n    RETRAINING --&gt; FORECAST\n    METRICS --&gt; RULES_ITERATION\n    RULES_ITERATION --&gt; RULES\n\n    style SKU fill:#e1f5ff\n    style INV fill:#e1f5ff\n    style DEMAND fill:#e1f5ff\n    style PROVIDERS fill:#e1f5ff\n    style CONSOLIDATE fill:#f3e5f5\n    style VALIDATION fill:#f3e5f5\n    style PATTERN fill:#fff3e0\n    style FORECAST fill:#fff3e0\n    style CONFIDENCE fill:#fff3e0\n    style MIN_INV fill:#f1f8e9\n    style MAX_INV fill:#f1f8e9\n    style ORDER_QTY fill:#f1f8e9\n    style LIFE_VALIDATION fill:#f1f8e9\n    style PROVIDER_SELECT fill:#f1f8e9\n    style RULES fill:#fce4ec\n    style RECOMMEND fill:#fce4ec\n    style NATURAL_LANG fill:#fce4ec\n    style APPROVAL fill:#c8e6c9\n    style FEEDBACK fill:#c8e6c9\n    style EXECUTION fill:#c8e6c9\n    style METRICS fill:#bbdefb\n    style RETRAINING fill:#bbdefb\n    style RULES_ITERATION fill:#bbdefb&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="8KWmYR4VYMaHl69XR4iP-1">
